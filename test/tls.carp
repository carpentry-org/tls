(load "../tls.carp")
(load "Test.carp")

(use Test)

; ---------------------------------------------------------------------------
; Helpers
; ---------------------------------------------------------------------------

(defn https-get [host path]
  (match (TlsStream.connect host 443)
    (Result.Success s)
      (let [req (String.concat &[@"GET " @path @" HTTP/1.1\r\nHost: " @host @"\r\nConnection: close\r\n\r\n"])]
        (do
          (ignore (TlsStream.send &s &req))
          (let [resp (the (Result String String) (TlsStream.read &s))]
            (do
              (TlsStream.close s)
              resp))))
    (Result.Error e) (Result.Error e)))

; ---------------------------------------------------------------------------
; Tests
; ---------------------------------------------------------------------------

(deftest test

  ; =========================================================================
  ; Connection
  ; =========================================================================

  (assert-true test
    (Result.success? &(TlsStream.connect "example.com" 443))
    "connect to example.com:443 succeeds"
  )

  (assert-true test
    (Result.error? &(TlsStream.connect "localhost" 1))
    "connect to unreachable address returns error"
  )

  (assert-true test
    (match (TlsStream.connect "localhost" 1)
      (Result.Error e) (> (String.length &e) 0)
      _ false)
    "failed connection produces non-empty error message"
  )

  ; =========================================================================
  ; Send and read (string)
  ; =========================================================================

  (assert-true test
    (match (https-get "example.com" "/")
      (Result.Success body) (String.starts-with? &body "HTTP/1.1")
      _ false)
    "GET request returns HTTP response"
  )

  (assert-true test
    (match (https-get "example.com" "/")
      (Result.Success body) (String.contains-string? &body "200 OK")
      _ false)
    "GET to example.com returns 200 OK"
  )

  ; =========================================================================
  ; Send and read (bytes)
  ; =========================================================================

  (assert-true test
    (match (TlsStream.connect "example.com" 443)
      (Result.Success s)
        (let [req "GET / HTTP/1.1\r\nHost: example.com\r\nConnection: close\r\n\r\n"
              bytes (Array.copy-map &(fn [c] (Byte.from-int (Char.to-int @c))) &(String.chars req))
              sent (TlsStream.send-bytes &s &bytes)]
          (match sent
            (Result.Success n)
              (let [resp (the (Result (Array Byte) String) (TlsStream.read-bytes &s))]
                (do
                  (TlsStream.close s)
                  (match resp
                    (Result.Success data) (> (Array.length &data) 0)
                    _ false)))
            _ (do (TlsStream.close s) false)))
      _ false)
    "send-bytes and read-bytes roundtrip"
  )

  ; =========================================================================
  ; read-append
  ; =========================================================================

  (assert-true test
    (match (TlsStream.connect "example.com" 443)
      (Result.Success s)
        (let [req "GET / HTTP/1.1\r\nHost: example.com\r\nConnection: close\r\n\r\n"]
          (do
            (ignore (TlsStream.send &s req))
            (let [buf (the (Array Byte) (Array.allocate 0))
                  n (TlsStream.read-append &s &buf)]
              (do
                (TlsStream.close s)
                (match n
                  (Result.Success count) (> count 0)
                  _ false)))))
      _ false)
    "read-append appends data to buffer"
  )

  ; =========================================================================
  ; close!
  ; =========================================================================

  (assert-true test
    (match (TlsStream.connect "example.com" 443)
      (Result.Success s)
        (do
          (TlsStream.close! &s)
          true)
      _ false)
    "close! by reference does not crash"
  )

  ; =========================================================================
  ; set-timeout
  ; =========================================================================

  (assert-true test
    (match (TlsStream.connect "example.com" 443)
      (Result.Success s)
        (do
          (TlsStream.set-timeout &s 5)
          (TlsStream.close s)
          true)
      _ false)
    "set-timeout does not error"
  )

  ; =========================================================================
  ; Empty read after connection close
  ; =========================================================================

  (assert-true test
    (match (TlsStream.connect "example.com" 443)
      (Result.Success s)
        (do
          (ignore (TlsStream.send &s "GET / HTTP/1.1\r\nHost: example.com\r\nConnection: close\r\n\r\n"))
          ; read until empty (server closes after response)
          (let-do [found false
                   i 0]
            (while (and (not found) (< i 100))
              (do
                (let [r (the (Result String String) (TlsStream.read &s))]
                  (match r
                    (Result.Success chunk)
                      (when (= (String.length &chunk) 0)
                        (set! found true))
                    _ ()))
                (set! i (+ i 1))))
            (TlsStream.close s)
            found))
      _ false)
    "read returns empty string after connection close"
  )
)
