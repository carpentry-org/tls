(load "../tls.carp")
(load "Test.carp")

(relative-include "test_helpers.h")

(use Test)

(register test-start-echo-server (Fn [] Int) "carp_test_start_echo_server")
(register test-generate-cert (Fn [] Int) "carp_test_generate_cert_")
(register test-connect-insecure
  (Fn [Int] TlsStream)
  "carp_test_connect_insecure")
(register test-stream-ok (Fn [&TlsStream] Int) "carp_test_stream_ok")
(register test-cleanup (Fn [] ()) "carp_test_cleanup")
(register test-cert-path (Fn [] String) "carp_test_cert_path_")
(register test-key-path (Fn [] String) "carp_test_key_path_")
(register test-listen (Fn [] Int) "carp_test_listen")
(register test-get-port (Fn [] Int) "carp_test_get_port")
(register test-accept-tcp (Fn [Int] Int) "carp_test_accept_tcp")
(register test-fork-client
  (Fn [Int &String] Int)
  "carp_test_fork_insecure_client")
(register test-close-fd (Fn [Int] ()) "carp_test_close_fd")

(defn https-get [host path]
  (match (TlsStream.connect host 443)
    (Result.Success s)
      (let-do [req (String.concat
                 &[@"GET "
                   @path
                   @" HTTP/1.1\r\nHost: "
                   @host
                   @"\r\nConnection: close\r\n\r\n"])]
        (ignore (TlsStream.send &s &req))
        (let-do [resp (the (Result String String) (TlsStream.read &s))]
          (TlsStream.close s)
          resp))
    (Result.Error e) (Result.Error e)))

(deftest test

  (assert-true test
    (Result.success? &(TlsStream.connect "example.com" 443))
    "connect to example.com:443 succeeds")

  (assert-true test
    (Result.error? &(TlsStream.connect "localhost" 1))
    "connect to unreachable address returns error")

  (assert-true test
    (match (TlsStream.connect "localhost" 1)
      (Result.Error e) (> (String.length &e) 0)
      _ false)
    "failed connection produces non-empty error message")

  (assert-true test
    (match (https-get "example.com" "/")
      (Result.Success body) (String.starts-with? &body "HTTP/1.1")
      _ false)
    "GET request returns HTTP response")

  (assert-true test
    (match (https-get "example.com" "/")
      (Result.Success body) (String.contains-string? &body "200 OK")
      _ false)
    "GET to example.com returns 200 OK")

  (assert-true test
    (match (TlsStream.connect "example.com" 443)
      (Result.Success s)
        (let [req "GET / HTTP/1.1\r\nHost: example.com\r\nConnection: close\r\n\r\n"
              bytes (Array.copy-map
                &(fn [c] (Byte.from-int (Char.to-int @c)))
                &(String.chars req))
              sent (TlsStream.send-bytes &s &bytes)]
          (match sent
            (Result.Success n)
              (let-do [resp (the (Result (Array Byte) String)
                                 (TlsStream.read-bytes &s))]
                (TlsStream.close s)
                (match resp
                  (Result.Success data) (> (Array.length &data) 0)
                  _ false))
            _ (do (TlsStream.close s) false)))
      _ false)
    "send-bytes and read-bytes roundtrip")

  (assert-true test
    (match (TlsStream.connect "example.com" 443)
      (Result.Success s)
        (let-do [req "GET / HTTP/1.1\r\nHost: example.com\r\nConnection: close\r\n\r\n"]
          (ignore (TlsStream.send &s req))
          (let-do [buf (the (Array Byte) (Array.allocate 0))
                   n (TlsStream.read-append &s &buf)]
            (TlsStream.close s)
            (match n (Result.Success count) (> count 0) _ false)))
      _ false)
    "read-append appends data to buffer")

  (assert-true test
    (match (TlsStream.connect "example.com" 443)
      (Result.Success s) (do (TlsStream.close! &s) true)
      _ false)
    "close! by reference does not crash")

  (assert-true test
    (match (TlsStream.connect "example.com" 443)
      (Result.Success s)
        (do (TlsStream.set-timeout &s 5) (TlsStream.close s) true)
      _ false)
    "set-timeout does not error")

  (assert-true test
    (match (TlsStream.connect "example.com" 443)
      (Result.Success s)
        (do
          (ignore
            (TlsStream.send &s
                            "GET / HTTP/1.1\r\nHost: example.com\r\nConnection: close\r\n\r\n"))
          ; read until empty (server closes after response)
          (let-do [found false
                   i 0]
            (while-do (and (not found) (< i 100))
              (let [r (the (Result String String) (TlsStream.read &s))]
                (match r
                  (Result.Success chunk)
                    (when (= (String.length &chunk) 0) (set! found true))
                  _ ()))
              (set! i (+ i 1)))
            (TlsStream.close s)
            found))
      _ false)
    "read returns empty string after connection close")

  (assert-true test
    (if (= (test-generate-cert) -1)
      false
      (let [cert (test-cert-path)
            key (test-key-path)]
        (match (TlsServerCtx.create &cert &key)
          (Result.Success ctx) (do (TlsServerCtx.close ctx) (test-cleanup) true)
          _ (do (test-cleanup) false))))
    "TlsServerCtx.create with valid cert/key succeeds")

  (assert-true test
    (Result.error?
      &(TlsServerCtx.create "/nonexistent/cert.pem" "/nonexistent/key.pem"))
    "TlsServerCtx.create with invalid paths returns error")

  (assert-true test
    (let [port (test-start-echo-server)]
      (if (= port -1)
        false
        (let [s (test-connect-insecure port)]
          (if (= (test-stream-ok &s) 0)
            (do (test-cleanup) false)
            (let [sent (TlsStream.send &s "hello from carp")]
              (match sent
                (Result.Success _n)
                  (match (the (Result String String) (TlsStream.read &s))
                    (Result.Success resp)
                      (do
                        (TlsStream.close s)
                        (test-cleanup)
                        (= &resp "hello from carp"))
                    _ (do (TlsStream.close s) (test-cleanup) false))
                _ (do (TlsStream.close s) (test-cleanup) false)))))))
    "loopback TLS echo: send and receive through server")

  (assert-true test
    (let [port (test-start-echo-server)]
      (if (= port -1)
        false
        (let [s (test-connect-insecure port)
              msg "hello"
              bytes (Array.copy-map
                &(fn [c] (Byte.from-int (Char.to-int @c)))
                &(String.chars msg))]
          (if (= (test-stream-ok &s) 0)
            (do (test-cleanup) false)
            (match (TlsStream.send-bytes &s &bytes)
              (Result.Success _n)
                (match (the (Result (Array Byte) String)
                            (TlsStream.read-bytes &s))
                  (Result.Success data)
                    (do
                      (TlsStream.close s)
                      (test-cleanup)
                      (= (Array.length &data) 5))
                  _ (do (TlsStream.close s) (test-cleanup) false))
              _ (do (TlsStream.close s) (test-cleanup) false))))))
    "loopback TLS echo: send-bytes and read-bytes roundtrip")

  ; The loopback server presents a self-signed cert. A real client connect
  ; (SSL_VERIFY_PEER) must reject it, and the error must be captured at the
  ; failure site (after SSL_free/close) rather than read back as stale state.
  (assert-true test
    (let [port (test-start-echo-server)]
      (if (= port -1)
        false
        (let-do [ok (match (TlsStream.connect "localhost" port)
                   (Result.Error e)
                     (and (> (String.length &e) 0)
                          (String.contains-string? &e "certificate"))
                   (Result.Success s) (do (TlsStream.close s) false))]
          (test-cleanup)
          ok)))
    "client rejects untrusted self-signed cert with a captured error message")

  (assert-true test
    (if (= (test-generate-cert) -1)
      false
      (let [lfd (test-listen)]
        (if (< lfd 0)
          false
          (let [port (test-get-port)
                cert (test-cert-path)
                key (test-key-path)]
            (match (TlsServerCtx.create &cert &key)
              (Result.Success ctx)
                (let-do [_ (test-fork-client port "hello tls accept")
                         cfd (test-accept-tcp lfd)
                         ok (match (TlsStream.accept &ctx cfd)
                           (Result.Success s)
                             (match (the (Result String String)
                                         (TlsStream.read &s))
                               (Result.Success msg)
                                 (do
                                   (TlsStream.close s)
                                   (= &msg "hello tls accept"))
                               (Result.Error _) (do (TlsStream.close s) false))
                           (Result.Error _) false)]
                  (TlsServerCtx.close ctx)
                  (test-close-fd lfd)
                  (test-cleanup)
                  ok)
              (Result.Error _) (do (test-close-fd lfd) (test-cleanup) false))))))
    "server accept: wrap a TCP fd with TLS and read a client message")

  (assert-true test
    (let [port (test-start-echo-server)]
      (if (= port -1)
        false
        (let [s (test-connect-insecure port)]
          (if (= (test-stream-ok &s) 0)
            (do (test-cleanup) false)
            (let-do [msg "nonblocking echo"
                     bytes (Array.copy-map
                       &(fn [c] (Byte.from-int (Char.to-int @c)))
                       &(String.chars msg))]
              (TlsStream.set-nonblocking &s)
              (let [ok (match (TlsStream.send-nb &s &bytes 0)
                      (Result.Success n)
                        (if (> n 0)
                          ; read-append-nb: may need to retry if WANT_READ
                          (let-do [buf (the (Array Byte) (Array.allocate 0))
                                   got 0
                                   tries 0]
                            (while-do (and (= got 0) (< tries 1000000))
                              (match (TlsStream.read-append-nb &s &buf)
                                (Result.Success k) (when (> k 0) (set! got k))
                                _ ())
                              (set! tries (+ tries 1)))
                            (TlsStream.close s)
                            (test-cleanup)
                            (and (> got 0)
                                 (= (Array.length &buf) (String.length msg))))
                          (do (TlsStream.close s) (test-cleanup) false))
                      _ (do (TlsStream.close s) (test-cleanup) false))]
                ok))))))
    "non-blocking loopback: send-nb and read-append-nb roundtrip")

  (assert-equal test -2 TlsStream.read-blocked "read-blocked sentinel is -2")

  (assert-true test
    (let [port (test-start-echo-server)]
      (if (= port -1)
        false
        (let [s (test-connect-insecure port)]
          (if (= (test-stream-ok &s) 0)
            (do (test-cleanup) false)
            (do
              (TlsStream.set-nonblocking &s)
              (TlsStream.close s)
              (test-cleanup)
              true)))))
    "set-nonblocking does not crash on a valid stream"))
